---
/* ============================================================
   Bearings — Safety (the three routes)
   Differentiated by position, label, and shape — not color alone
   (a11y: color-blind users). Condition-action language. No
   moralism. Referrals pulled from the single-source-of-truth file.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { referrals, emergency, lastVerified } from "../lib/referrals.ts";

// draft safety content is authored but never rendered — it is how
// this material gets staged before a clinician signs it off.
const safety = (await getCollection("safety")).filter((e) => !e.data.draft);
// Pre-render each entry's Content in frontmatter (v7: render() must
// resolve here, not inside a nested async map in the template).
const rendered = await Promise.all(
  safety.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
const byRoute = (r: string) => rendered.filter((x) => x.entry.data.route === r);

/* Urgent first. This page previously ran pause -> clinician -> urgent,
   which put the one time-critical route last and below the fold on a
   phone. /between.astro already hands off urgently at the top; this
   page now matches it.

   These are three separate doors, not steps — deliberately unnumbered.
   A visible "Route 01/02/03" read as a sequence on the one page where
   the product otherwise refuses sequences, and numbered urgent last. */
const routes = [
  {
    id: "urgent",
    label: "Get urgent help now",
    entries: byRoute("urgent"),
  },
  {
    id: "clinician",
    label: "Talk with a qualified clinician",
    entries: byRoute("clinician"),
  },
  {
    id: "pause",
    label: "Consider pausing or reconsidering",
    entries: byRoute("pause"),
  },
];
---

<BaseLayout title="Support & safety — Bearings" section="safety">
  <section class="reading">
    <p class="kicker">Always here · three routes</p>
    <h1>Support &amp; safety</h1>
    <p class="lede">
      Three different routes, depending on what you need. Preparation can
      help, but it cannot guarantee an easy or safe experience.
    </p>
  </section>

  {/* Same wording as the handoff at the top of /between.astro. Someone
      arriving here from the footer mid-crisis should not have to read
      or scroll to find this. */}
  <aside class="now" role="note">
    <p>
      If someone has chest pain, a very high temperature, a seizure, will not
      wake up, or is talking about ending their life, that is not something to
      read about. {emergency.note}
    </p>
  </aside>

  <div class="routes">
    {
      routes.map((route) => (
        <section class={`route route--${route.id}`} aria-labelledby={`h-${route.id}`}>
          <div class="route-head">
            <span class={`marker marker--${route.id}`} aria-hidden="true" />
            <h2 id={`h-${route.id}`}>{route.label}</h2>
          </div>
          {route.entries.map(({ entry, Content }) => (
            <div class="route-body">
              {entry.data.condition && (
                <p class="condition">{entry.data.condition}</p>
              )}
              <Content />
            </div>
          ))}
        </section>
      ))
    }
  </div>

  <section class="reading referrals" aria-labelledby="ref-h">
    <h2 id="ref-h">Where to reach people</h2>
    <ul class="ref-list">
      {
        referrals.map((r) => (
          <li>
            <span class="ref-name">{r.name}</span>
            <span class="ref-who">{r.who}</span>
            <a
              class="ref-detail"
              href={r.href}
              target={r.href.startsWith("https:") ? "_blank" : undefined}
              rel={r.href.startsWith("https:") ? "noopener noreferrer" : undefined}
            >
              {r.detail}
            </a>
            <span class="ref-region">{r.region}</span>
          </li>
        ))
      }
    </ul>
    <p class="verified">
      {emergency.note} Last checked {lastVerified}. If a number looks out of
      date, treat local emergency services as the reliable route.
    </p>
  </section>
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
  .lede {
    font-size: var(--size-lg);
    color: var(--ink-soft);
    margin-top: var(--space-3);
    max-width: 52ch;
  }
  /* Shaped as well as coloured so it does not depend on colour
     perception (a11y) — same treatment as /between.astro. */
  .now {
    border: 2px solid var(--route-urgent);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-top: var(--space-5);
    max-width: var(--measure);
  }
  .now p {
    margin: 0;
  }
  .routes {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-5) 0;
  }
  .route {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-4);
    background: var(--paper-raised);
  }
  .route-index {
    margin-bottom: var(--space-2);
    text-transform: uppercase;
  }
  .route-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  /* shape differs per route, not only color (a11y) */
  .marker {
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .marker--pause {
    background: var(--route-pause);
    border-radius: 50%;
  }
  .marker--clinician {
    background: var(--route-clinician);
    border-radius: 2px;
  }
  .marker--urgent {
    background: var(--route-urgent);
    /* triangle: distinct shape for urgent */
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .route--urgent {
    border-color: var(--route-urgent);
    border-width: 2px;
  }
  .condition {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }
  .referrals {
    margin-top: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .ref-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .ref-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  .ref-name {
    font-weight: 600;
  }
  .ref-detail,
  .ref-who,
  .ref-region {
    color: var(--ink-soft);
    font-size: var(--size-sm);
  }
  .verified {
    color: var(--ink-faint);
    font-size: var(--size-sm);
    margin-top: var(--space-3);
  }
</style>
