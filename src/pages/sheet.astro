---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sheet from "../components/Sheet.svelte";
---

<BaseLayout title="The Sheet — Bearings" section="before">
  <div class="sheet-page">
    <section class="reading">
      <p class="kicker">Print-first · nothing saved</p>
      <h1>The Sheet</h1>
      <p class="lede">
        A one-page plan you fill out ahead of time and print. If-then plans
        made in advance tend to hold up even when in-the-moment thinking does
        not.
      </p>
    </section>
    <Sheet client:load />
  </div>
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
  .lede {
    margin-bottom: var(--space-4);
  }
</style>
