---
/* ============================================================
   Bearings — /sheet (hub)

   Three guided worksheets and the day-of safety Sheet:
   - The safety Sheet (/sheet itself): day-of logistics — what,
     when, who to call, if-then plans. The original.
   - The preparation worksheet: the deeper thinking page for the
     days-to-weeks before.
   - The integration worksheet: the structured page for after.

   All three share one posture: fillable in memory, nothing saved,
   print or save-as-PDF is the artifact.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import Sheet from "../components/Sheet.svelte";
import SheetConstellation from "../components/SheetConstellation.astro";
import { GUIDED_WORKSHEETS } from "../lib/worksheets.ts";
---

<BaseLayout title="Worksheets — Bearings" section="sheet">
  <div class="sheet-page">
    <section class="reading">
      <p class="kicker">Print-first · nothing saved</p>
      <h1>Worksheets</h1>
      <p class="lede">
        Fill a sheet out ahead of time and print it — or save it as a PDF.
        Plans made in advance tend to hold up even when in-the-moment
        thinking does not.
      </p>
    </section>

    <SheetConstellation variant="hub" />

    <nav class="sheet-index" aria-label="The guided worksheets">
      {
        GUIDED_WORKSHEETS.map((item, index) => (
          <a href={item.href} class="sheet-card">
            <div class="sheet-card-head">
              <span class="sheet-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <p class="sheet-phase">{item.phase}</p>
                <h2>{item.worksheet.title}</h2>
              </div>
            </div>
            <p>{item.summary}</p>
            <span class="when">{item.when}</span>
          </a>
        ))
      }
    </nav>

    <section class="safety-sheet" id="safety-sheet">
      <div class="sheet-card-head">
        <span class="sheet-number" aria-hidden="true">00</span>
        <h2>The safety Sheet</h2>
      </div>
      <p class="lede">
        Day-of logistics on one page: substance and testing, start and end
        times, who to call, if–then plans, what "handled" means, and the
        safety strip. If you only print one thing, this is the one. If the
        preparation worksheet is already filled, its if–then plans carry
        across as they are.
      </p>
    </section>

    <Sheet client:load />
  </div>
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
  .lede {
    margin-bottom: var(--space-4);
  }
  .sheet-index {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-bottom: var(--space-6);
  }
  .sheet-card {
    display: block;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease;
  }
  .sheet-card:hover,
  .sheet-card:focus-visible {
    border-color: var(--gold);
  }
  .sheet-card-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .sheet-number {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold-bright);
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.12em;
  }
  .sheet-phase {
    color: var(--ink-faint);
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sheet-card-head h2,
  .safety-sheet h2 {
    font-size: var(--size-lg);
  }
  .sheet-card > p {
    color: var(--ink-soft);
    font-size: var(--size-sm);
    line-height: var(--leading-body);
  }
  .sheet-card .when {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
</style>
