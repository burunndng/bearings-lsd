---
/* ============================================================
   Bearings — /sheet/preparation

   The deeper companion to the day-of safety Sheet: a structured
   page to think through why, when, who, what, and what happens if
   it gets hard — the set-and-setting work, on paper. Content is
   defined in lib/worksheets.ts; this page is only the route.

   Nothing persisted. Print or save-as-PDF is the artifact.
   ============================================================ */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Worksheet from "../../components/Worksheet.svelte";
import { PREPARATION_WORKSHEET } from "../../lib/worksheets.ts";
---

<BaseLayout title="Preparation worksheet — Bearings" section="before">
  <div class="sheet-page">
    <section class="reading">
      <p class="kicker">{PREPARATION_WORKSHEET.kicker}</p>
      <h1>{PREPARATION_WORKSHEET.title}</h1>
      <p class="lede">{PREPARATION_WORKSHEET.lede}</p>
      <p class="hub-link no-print">
        Part of <a href="/sheet">the Sheets</a> · the day-of logistics one is{" "}
        <a href="/sheet">the safety Sheet</a>
      </p>
    </section>
    <Worksheet worksheet={PREPARATION_WORKSHEET} client:load />
  </div>
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
  .lede {
    margin-bottom: var(--space-4);
  }
  .hub-link {
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
  }
  .hub-link a {
    color: var(--gold);
  }
</style>
