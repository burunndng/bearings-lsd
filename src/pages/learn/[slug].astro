---
/* ============================================================
   Bearings — Learn detail
   Sourced, dated evidence. Sources listed with year and link.
   ============================================================ */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("learn")).filter((e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"learn">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString("en-CA", { year: "numeric", month: "long" }) : null;
---

<BaseLayout title={`${entry.data.title} — Bearings`} section="learn">
  <article class="reading">
    <p class="crumb"><a href="/learn">&larr; Learn</a></p>
    <h1>{entry.data.title}</h1>
    {
      fmt(entry.data.lastReviewed) && (
        <p class="rev meta">Last reviewed {fmt(entry.data.lastReviewed)}</p>
      )
    }

    <div class="body">
      <Content />
    </div>

    {
      entry.data.sources.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ul>
            {entry.data.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.cite}</a> : s.cite}
                {s.year && ` (${s.year})`}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  article {
    margin-top: var(--space-5);
  }
  .crumb {
    margin-bottom: var(--space-3);
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .crumb a {
    color: var(--ink-faint);
    text-decoration-color: var(--rule);
    transition: color 0.25s ease;
  }
  .crumb a:hover {
    color: var(--gold-bright);
  }
  .rev {
    text-transform: uppercase;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .body :global(p) {
    margin-bottom: var(--space-3);
  }
  .body :global(ul) {
    margin-bottom: var(--space-3);
    padding-left: var(--space-4);
  }
  .body :global(li) {
    margin-bottom: var(--space-1);
  }
  .sources {
    margin-top: var(--space-6);
    margin-bottom: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .sources h2 {
    font-size: var(--size-lg);
    margin-bottom: var(--space-3);
  }
  .sources li {
    color: var(--ink-soft);
    font-size: var(--size-sm);
    margin-bottom: var(--space-2);
  }
</style>
