---
/* ============================================================
   Bearings — Learn detail
   Sourced, dated evidence. Sources listed with year and link.
   ============================================================ */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("learn")).filter((e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"learn">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString("en-CA", { year: "numeric", month: "long" }) : null;
---

<BaseLayout title={`${entry.data.title} — Bearings`} section="learn">
  <article class={entry.data.tone === "deep" ? "reading deep" : "reading"}>
    <p class="crumb"><a href="/learn">&larr; Learn</a></p>
    <h1>{entry.data.title}</h1>
    {
      fmt(entry.data.lastReviewed) && (
        <p class="rev meta">Last reviewed {fmt(entry.data.lastReviewed)}</p>
      )
    }

    <div class="body">
      <Content />
    </div>

    {
      entry.data.sources.length > 0 && (
        <section class="sources">
          <h2>Sources</h2>
          <ul>
            {entry.data.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url}>{s.cite}</a> : s.cite}
                {s.year && ` (${s.year})`}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  article {
    margin-top: var(--space-5);
  }
  /* Deep-work register on the detail page: a garnet rule above the
     title, same contemplative weight as the shelf card. */
  article.deep h1 {
    border-top: 3px solid var(--garnet);
    padding-top: var(--space-4);
  }
  .crumb {
    margin-bottom: var(--space-3);
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .crumb a {
    color: var(--ink-faint);
    text-decoration-color: var(--rule);
    transition: color 0.25s ease;
  }
  .crumb a:hover {
    color: var(--gold-bright);
  }
  .rev {
    text-transform: uppercase;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .body :global(p) {
    margin-bottom: var(--space-3);
  }
  .body :global(ul) {
    margin-bottom: var(--space-3);
    padding-left: var(--space-4);
  }
  .body :global(li) {
    margin-bottom: var(--space-1);
  }

  /* Markdown tables. Wide-prose tables are the failure mode here —
     three columns of sentences in a grid reads as a wall. These
     rules keep a table scannable on wide screens and restructure it
     into stacked cards below the narrow breakpoint, where the first
     cell of each row becomes that row's heading. */
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-4);
    font-size: var(--size-sm);
  }
  .body :global(th) {
    text-align: left;
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 400;
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--rule);
  }
  .body :global(td) {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: var(--leading-body);
  }
  .body :global(td:first-child) {
    min-width: 9rem;
  }
  @media (max-width: 40rem) {
    .body :global(thead) {
      display: none;
    }
    .body :global(table),
    .body :global(tbody),
    .body :global(tr),
    .body :global(td) {
      display: block;
      width: 100%;
    }
    .body :global(tr) {
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      padding: var(--space-3);
      margin-bottom: var(--space-3);
    }
    .body :global(td) {
      border-bottom: none;
      padding: 0;
    }
    .body :global(td:first-child) {
      color: var(--gold-bright);
      margin-bottom: var(--space-1);
    }
  }
  .sources {
    margin-top: var(--space-6);
    margin-bottom: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }
  .sources h2 {
    font-size: var(--size-lg);
    margin-bottom: var(--space-3);
  }
  .sources li {
    color: var(--ink-soft);
    font-size: var(--size-sm);
    margin-bottom: var(--space-2);
  }
</style>
