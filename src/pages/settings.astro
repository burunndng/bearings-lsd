---
import BaseLayout from "../layouts/BaseLayout.astro";
import Settings from "../components/Settings.svelte";
import { getCollection } from "astro:content";

/* Card titles for the export, resolved at build time. A note written
   from a card stores only its cardId, so without this the exported
   file would name a slug ("writing-it-down") where the person expects
   a title. Drafts included deliberately: a note may outlive the
   published state of the card it came from, and an export that
   silently dropped its title would be the worse outcome. */
const cardTitles = Object.fromEntries(
  (await getCollection("cards")).map((c) => [c.id, c.data.title]),
);
---

<BaseLayout title="Settings — Bearings" section="settings">
  <section class="reading">
    <p class="kicker">What this browser remembers</p>
    <h1>Settings</h1>
    <p class="lede">Choose what this browser remembers. Nothing here is required.</p>
  </section>
  <Settings client:load {cardTitles} />
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
</style>
