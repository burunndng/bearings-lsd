---
/* ============================================================
   Bearings — In between (the acute phase)
   The home copy promises "before, after, or somewhere in between".
   This is that surface. It also gives the urgent route a home that
   is not only the footer.

   Density is deliberately low and the safety handoff sits at the
   top, not the bottom: someone reading this may be reading it mid
   experience, or on behalf of someone who is.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import ShelfList from "../components/ShelfList.astro";
import { getCollection } from "astro:content";
/* No ShelfFilter here: `between` is frozen as a zero-card triage
   surface (locked decision). Filtering UI for a shelf that never
   carries cards would be noise, not a feature. */

const cards = (await getCollection("cards")).filter(
  (c) => c.data.shelf === "between" && !c.data.draft,
);
---

<BaseLayout title="In between — Bearings" section="between">
  <section class="reading">
    <p class="kicker">While it is happening</p>
    <h1>In between</h1>
    <p class="lede">
      Plain, short options for while something is underway — for you, or for
      someone you are with.
    </p>
  </section>

  <aside class="now" role="note">
    <p>
      If someone has chest pain, a very high temperature, a seizure, will not
      wake up, or is talking about ending their life, that is not something to
      read about. <a href="/safety">Get urgent help now</a> or call your local
      emergency number.
    </p>
  </aside>

  <ShelfList cards={cards} shelf="between" />
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
  .lede {
    margin-bottom: var(--space-4);
  }
  /* Urgent handoff first, and shaped as well as coloured so it does
     not depend on colour perception (a11y). */
  .now {
    border: 2px solid var(--route-urgent);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-bottom: var(--space-5);
    max-width: var(--measure);
  }
  .now p {
    margin: 0;
  }
</style>
