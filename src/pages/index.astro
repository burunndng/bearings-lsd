---
/* ============================================================
   Bearings — Home
   No "Start your transformation." No funnel. A place to get
   bearings. Equal-weight chooser, three plain sections.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import MotivationChooser from "../components/MotivationChooser.svelte";
import PillarGlyph from "../components/PillarGlyph.astro";
---

<BaseLayout>
  <section class="hero reading">
    <div class="hero-copy">
      <p class="kicker">// bearings</p>
      <h1>A place to get your <em>bearings</em>.</h1>
      <p class="lede">
        Preparation and reflection around psychedelic experiences — and
        around other things that are intense in their own way. Before,
        in between, or after. Nothing here is required. Take what helps;
        leave what does not.
      </p>
    </div>
    <picture class="hero-art">
      <source srcset="/img/bearings-lockup.webp" type="image/webp" />
      <img
        src="/img/bearings-lockup.png"
        alt=""
        class="hero-logo"
        width="608"
        height="530"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </section>

  <section class="chooser" aria-labelledby="chooser-h">
    <h2 id="chooser-h" class="section-h">What brings you here?</h2>
    <p class="section-note">
      There is no required reason. This is a place for psychedelic
      preparation and integration, and if you are here for something
      else intense, the shelves still mostly fit. Pick whatever fits
      right now, or don't — you can browse everything either way.
    </p>
    <MotivationChooser client:visible />
  </section>

  <div class="rule--north" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 12 L12 4.5"></path>
      <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"></circle>
    </svg>
  </div>

  <nav class="sections" aria-label="Phases">
    <a class="card phase-card" href="/before">
      <PillarGlyph name="before" size={42} />
      <div>
        <h3>Before</h3>
        <p>Logistics, support, boundaries, expectations, safety.</p>
      </div>
    </a>
    <a class="card phase-card" href="/between">
      <PillarGlyph name="between" size={42} />
      <div>
        <h3>In between</h3>
        <p>A small constellation of orientation while something is underway.</p>
      </div>
    </a>
    <a class="card phase-card" href="/integration">
      <PillarGlyph name="integration" size={42} />
      <div>
        <h3>Integration</h3>
        <p>Rest, notes, connection, unsettled feelings, resources.</p>
      </div>
    </a>
  </nav>

  <section class="deeper" aria-labelledby="deeper-h">
    <div class="deeper-heading">
      <p class="kicker">// beyond the moment</p>
      <h2 id="deeper-h" class="section-h">Go deeper</h2>
      <p class="section-note">
        Learn the evidence, work with a prompt, print a page, or find a
        source worth keeping.
      </p>
    </div>
    <nav class="deeper-grid" aria-label="Learn, worksheets, resources, and deep work">
      <a class="deep-card" href="/learn">
        <PillarGlyph name="learn" size={52} />
        <div>
          <h3>Learn</h3>
          <p>Evidence, uncertainty, cultural context, and harm reduction.</p>
        </div>
      </a>
      <a class="deep-card" href="/sheet">
        <PillarGlyph name="sheets" size={52} />
        <div>
          <h3>Worksheets</h3>
          <p>Printable pages for before, the day of, and after.</p>
        </div>
      </a>
      <a class="deep-card" href="/resources">
        <PillarGlyph name="resources" size={52} />
        <div>
          <h3>Resources</h3>
          <p>Organizations, papers, and places worth returning to.</p>
        </div>
      </a>
      <a class="deep-card deep-card--accent" href="/learn#deep-work">
        <PillarGlyph name="deep-work" size={52} />
        <div>
          <h3>Deep Work</h3>
          <p>A quiet place to stay with one prompt until it changes shape.</p>
        </div>
      </a>
    </nav>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    align-items: center;
    gap: clamp(var(--space-4), 6vw, var(--space-7));
    max-width: none;
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-art {
    display: block;
    justify-self: end;
    width: min(100%, 360px);
  }
  .hero-logo {
    display: block;
    width: 100%;
    height: auto;
  }
  h1 {
    font-size: var(--size-display);
    line-height: 1.05;
    letter-spacing: 0.04em;
  }
  .lede {
    font-size: var(--size-lg);
    color: var(--dim);
    margin-top: var(--space-3);
    max-width: 46ch;
  }
  .section-h {
    font-size: var(--size-xl);
  }
  .chooser {
    position: relative;
    z-index: 2;
    margin-bottom: var(--space-6);
  }
  .sections {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-bottom: var(--space-6);
  }
  .phase-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .phase-card :global(.pillar-glyph) {
    flex: none;
    margin-top: var(--space-1);
    color: var(--gold);
  }
  .deeper {
    position: relative;
    z-index: 2;
    margin-bottom: var(--space-6);
  }
  .deeper-heading {
    max-width: var(--measure);
    margin-bottom: var(--space-4);
  }
  .deeper-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .deep-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
    min-height: 11rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .deep-card:hover,
  .deep-card:focus-visible {
    border-color: var(--gold);
    background: var(--paper-raised);
  }
  .deep-card :global(.pillar-glyph) {
    color: var(--ink-soft);
  }
  .deep-card--accent :global(.pillar-glyph) {
    color: var(--garnet);
  }
  .deep-card h3 {
    font-size: var(--size-lg);
    margin-bottom: var(--space-2);
  }
  .deep-card p {
    color: var(--ink-soft);
    font-size: var(--size-sm);
    line-height: var(--leading-body);
  }
  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero-art {
      justify-self: center;
      width: min(72vw, 300px);
    }
    .deeper-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
