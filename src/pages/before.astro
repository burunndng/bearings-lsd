---
/* ============================================================
   Bearings — Before shelf
   An open shelf of optional cards, not a program to complete.
   No progress bar, no ordering by importance. Horizon grouping is
   chronology only — see ShelfList.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";
import ShelfList from "../components/ShelfList.astro";
import ShelfFilter from "../components/ShelfFilter.svelte";
import { getCollection } from "astro:content";

const cards = (await getCollection("cards")).filter(
  (c) => c.data.shelf === "before" && !c.data.draft,
);
---

<BaseLayout title="Before — Bearings" section="before">
  <section class="reading">
    <p class="kicker">{cards.length} cards · none required</p>
    <h1>Before</h1>
    <p class="lede">
      Logistics, support, boundaries, expectations, safety. Pick only what
      matters to you. Nothing here is required.
    </p>
  </section>

  <ShelfFilter client:load />
  <ShelfList cards={cards} shelf="before" />

</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
  .lede {
    margin-bottom: var(--space-5);
  }
</style>
