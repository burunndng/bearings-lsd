---
import BaseLayout from "../layouts/BaseLayout.astro";
import Journal from "../components/Journal.svelte";
import Anchor from "../components/Anchor.svelte";
---

<BaseLayout title="Notes — Bearings" section="notes">
  <section class="reading">
    <p class="kicker">On this device only</p>
    <h1>Notes</h1>
    <p class="lede">
      A private place to put down a detail, a question, or nothing at all. You do
      not have to make a conclusion from an experience.
    </p>
  </section>
  <Journal client:load />
  <Anchor client:load />
</BaseLayout>

<style>
  section {
    margin-top: var(--space-5);
  }
</style>
