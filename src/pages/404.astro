---
/* ============================================================
   Bearings — 404
   A quiet dead end, not an error page. No drama, no tone that
   scolds. The one thing that must never be a dead end here is
   safety: if someone mistyped a URL mid-crisis, the first and
   only prominent action is the support page.
   ============================================================ */
import BaseLayout from "../layouts/BaseLayout.astro";

const sections = [
  { href: "/", label: "Home" },
  { href: "/before", label: "Before" },
  { href: "/between", label: "In between" },
  { href: "/integration", label: "Integration" },
  { href: "/learn", label: "Learn" },
  { href: "/resources", label: "Resources" },
];
---

<BaseLayout
  title="Not found — Bearings"
  description="This page is not here. The safety page is always available."
>
  <section class="lost reading">
    <p class="kicker">// nothing here</p>
    <h1>This page is not here.</h1>
    <p class="lede">
      It may have moved, or it may never have existed. Either way, nothing
      here needs your attention.
    </p>

    <aside class="now" role="note">
      <p>
        If you were looking for support, that is never a wrong turn:{" "}
        <a href="/safety">Support &amp; safety</a> is always here.
      </p>
    </aside>

    <p class="plain">The rest of Bearings is a few steps away:</p>
    <nav class="links" aria-label="Sections">
      {sections.map((s) => (
        <a href={s.href}>{s.label}</a>
      ))}
    </nav>
  </section>
</BaseLayout>

<style>
  .lost {
    margin-top: var(--space-7);
    margin-bottom: var(--space-7);
  }
  h1 {
    margin-top: var(--space-3);
  }
  .lede {
    color: var(--ink-soft);
    font-size: var(--size-lg);
    margin-top: var(--space-3);
  }
  .now {
    border: 2px solid var(--route-urgent);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin-top: var(--space-5);
  }
  .now p {
    margin: 0;
  }
  .plain {
    margin-top: var(--space-5);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
