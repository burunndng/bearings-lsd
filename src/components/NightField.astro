---
/* ============================================================
   Bearings — NightField (the living background)
   A field of drifting motes held against the void: one amber
   true-north ember, ultraviolet/indigo companions, hairline
   links that warm to amber near the pointer.

   Contracts (hard, photosafety is a feature):
   - Night theme only. Day renders clean paper, canvas stays empty.
   - prefers-reduced-motion OR data-motion="reduce": one static
     dim frame, no animation loop.
   - All motion slow (per-mote breathing 7-11s), nothing strobes.
   - Pointer pull only on fine pointers; touch never drags motes.
   Renders static HTML/canvas — no framework island.
   ============================================================ */
---

<canvas id="nightfield" aria-hidden="true"></canvas>

<style>
  #nightfield {
    display: var(--ground-display);
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
</style>

<script is:inline>
  (function () {
    var canvas = document.getElementById("nightfield");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    var root = document.documentElement;
    var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
    var motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    var finePointer = window.matchMedia("(pointer: fine)").matches;

    var w = 0,
      h = 0,
      dpr = 1,
      motes = [],
      mouse = { x: -9999, y: -9999 },
      raf = 0,
      running = false;

    function isNight() {
      var t = root.getAttribute("data-theme");
      if (t === "dark") return true;
      if (t === "light") return false;
      return darkQuery.matches;
    }

    function isStill() {
      return (
        motionQuery.matches || root.getAttribute("data-motion") === "reduce"
      );
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.width = window.innerWidth * dpr;
      h = canvas.height = window.innerHeight * dpr;
      canvas.style.width = window.innerWidth + "px";
      canvas.style.height = window.innerHeight + "px";
      build();
    }

    function build() {
      // Sparser than the splash: text lives over this field.
      var count = Math.min(
        80,
        Math.floor((window.innerWidth * window.innerHeight) / 22000),
      );
      motes = [];
      for (var i = 0; i < count; i++) {
        var gold = i === 0; // one true-north
        motes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.12 * dpr,
          vy: (Math.random() - 0.5) * 0.12 * dpr,
          r: (gold ? 2.4 : Math.random() * 1.4 + 0.5) * dpr,
          phase: Math.random() * Math.PI * 2,
          speed: 0.0007 + Math.random() * 0.001,
          gold: gold,
          hue: Math.random() < 0.5 ? "uv" : "indigo",
        });
      }
    }

    if (finePointer) {
      window.addEventListener("mousemove", function (e) {
        mouse.x = e.clientX * dpr;
        mouse.y = e.clientY * dpr;
      });
      window.addEventListener("mouseleave", function () {
        mouse.x = mouse.y = -9999;
      });
    }

    function paint(t) {
      var LINK = 130 * dpr;
      var PULL = 95 * dpr;
      ctx.clearRect(0, 0, w, h);

      for (var i = 0; i < motes.length; i++) {
        var p = motes[i];
        var dx = mouse.x - p.x,
          dy = mouse.y - p.y,
          d = Math.sqrt(dx * dx + dy * dy);
        if (d < PULL && d > 0.1) {
          var f = (1 - d / PULL) * 0.045;
          p.vx += (dx / d) * f;
          p.vy += (dy / d) * f;
        }
        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.985;
        p.vy *= 0.985;

        if (p.x < 0) p.x = w;
        if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h;
        if (p.y > h) p.y = 0;

        var glow = 0.28 + 0.28 * Math.sin(p.phase + t * p.speed);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        if (p.gold) {
          ctx.fillStyle =
            "rgba(255,200,94," + (0.55 + 0.25 * Math.sin(t * 0.0009)) + ")";
          ctx.shadowColor = "rgba(255,200,94,0.85)";
          ctx.shadowBlur = 16 * dpr;
        } else {
          var c = p.hue === "uv" ? "154,107,255" : "168,200,255";
          ctx.fillStyle = "rgba(" + c + "," + glow + ")";
          ctx.shadowColor = "rgba(" + c + ",0.4)";
          ctx.shadowBlur = 4 * dpr;
        }
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      for (var a = 0; a < motes.length; a++) {
        for (var b = a + 1; b < motes.length; b++) {
          var pa = motes[a],
            pb = motes[b];
          var ldx = pa.x - pb.x,
            ldy = pa.y - pb.y,
            ld = Math.sqrt(ldx * ldx + ldy * ldy);
          if (ld < LINK) {
            var near = Math.min(
              Math.sqrt(
                (mouse.x - pa.x) * (mouse.x - pa.x) +
                  (mouse.y - pa.y) * (mouse.y - pa.y),
              ),
              Math.sqrt(
                (mouse.x - pb.x) * (mouse.x - pb.x) +
                  (mouse.y - pb.y) * (mouse.y - pb.y),
              ),
            );
            var warm = near < 170 * dpr;
            var alpha = (1 - ld / LINK) * (warm ? 0.32 : 0.08);
            ctx.beginPath();
            ctx.moveTo(pa.x, pa.y);
            ctx.lineTo(pb.x, pb.y);
            ctx.strokeStyle = warm
              ? "rgba(255,200,94," + alpha + ")"
              : "rgba(110,110,126," + alpha + ")";
            ctx.lineWidth = dpr * 0.6;
            ctx.stroke();
          }
        }
      }
    }

    function frame(t) {
      paint(t);
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      running = false;
    }

    function sync() {
      if (!isNight()) {
        stop();
        ctx.clearRect(0, 0, w, h);
        return;
      }
      if (isStill()) {
        stop();
        paint(0); // one static dim frame — the field at rest
        return;
      }
      if (!running) {
        running = true;
        raf = requestAnimationFrame(frame);
      }
    }

    resize();
    sync();

    window.addEventListener("resize", function () {
      resize();
      if (isStill() || !isNight()) sync();
    });
    darkQuery.addEventListener("change", sync);
    motionQuery.addEventListener("change", sync);
    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ["data-theme", "data-motion"],
    });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) stop();
      else sync();
    });
  })();
</script>
