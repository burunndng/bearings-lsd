---
interface Props {
  name:
    | "before"
    | "between"
    | "integration"
    | "sheets"
    | "deep-work"
    | "resources"
    | "learn";
  size?: number;
  class?: string;
}

const { name, size = 48, class: className } = Astro.props;
---

<svg
  class:list={["pillar-glyph", className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "before" && (
      <>
        <circle cx="32" cy="24" r="12" />
        <path d="M5 46h54M32 12v34M15 46l17-13 17 13" />
        <path d="M24 7h16" />
      </>
    )
  }
  {
    name === "between" && (
      <>
        <circle cx="8" cy="32" r="3" />
        <circle cx="32" cy="32" r="3" />
        <circle cx="56" cy="32" r="3" />
        <path d="M8 32c8-16 16 16 24 0s16 16 24 0" />
        <path d="M4 18h56M4 46h56" opacity="0.45" />
      </>
    )
  }
  {
    name === "integration" && (
      <>
        <circle cx="32" cy="18" r="5" />
        <path d="M7 50c6-13 14-19 25-19s19 6 25 19" />
        <path d="M7 50h50M17 42h30M24 34h16" />
      </>
    )
  }
  {
    name === "sheets" && (
      <>
        <path d="M16 7h24l10 10v40H16z" />
        <path d="M40 7v10h10" />
        <path d="M22 25h22M22 33h22M22 41h14" />
        <circle cx="11" cy="44" r="4" />
      </>
    )
  }
  {
    name === "deep-work" && (
      <>
        <circle cx="32" cy="32" r="6" />
        <circle cx="32" cy="7" r="3" />
        <circle cx="32" cy="57" r="3" />
        <circle cx="7" cy="32" r="3" />
        <circle cx="57" cy="32" r="3" />
        <path d="M32 10v16M32 38v16M10 32h16M38 32h16" />
        <path d="m12 12 13 13M39 39l13 13M52 12 39 25M25 39 12 52" />
      </>
    )
  }
  {
    name === "resources" && (
      <>
        <ellipse cx="32" cy="32" rx="27" ry="11" />
        <ellipse cx="32" cy="32" rx="27" ry="11" transform="rotate(60 32 32)" />
        <ellipse cx="32" cy="32" rx="27" ry="11" transform="rotate(120 32 32)" />
        <circle cx="32" cy="32" r="6" />
        <circle cx="56" cy="22" r="2.5" />
        <circle cx="12" cy="45" r="2.5" />
      </>
    )
  }
  {
    name === "learn" && (
      <>
        <path d="M5 32s10-17 27-17 27 17 27 17-10 17-27 17S5 32 5 32Z" />
        <circle cx="32" cy="32" r="8" />
        <path d="M32 4v9M32 51v9M4 32h9M51 32h9" />
        <path d="m13 13 6 6M45 45l6 6M51 13l-6 6M19 45l-6 6" />
      </>
    )
  }
</svg>

<style>
  .pillar-glyph {
    overflow: visible;
    color: var(--ink-soft);
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pillar-glyph circle:first-child {
    fill: color-mix(in srgb, var(--gold) 18%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pillar-glyph {
      transition: color 0.25s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
</style>
