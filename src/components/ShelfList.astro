---
/* ============================================================
   Bearings — ShelfList
   One renderer for every shelf, so Before / In between /
   Integration cannot drift apart in markup or a11y behaviour.

   Horizon grouping is advisory chronology ONLY. Deliberately absent:
   counts per group, numbering, "next", completion state, or any
   visual weighting between groups. A shelf is an open shelf.
   Cards with no horizon render in a plain unlabelled group.
   ============================================================ */
import type { CollectionEntry } from "astro:content";
import { groupByHorizon, type Shelf } from "../lib/shelves.ts";

interface Props {
  cards: CollectionEntry<"cards">[];
  /* Which shelf this list belongs to. Used below to give `between`
     its own empty-state copy — that shelf is at zero cards by design,
     not by omission, and the generic empty state would misread it. */
  shelf: Shelf;
}

const { cards, shelf } = Astro.props;
const { grouped, untimed } = groupByHorizon(cards);

/* When nothing carries a horizon, render one flat list rather than a
   single pointless section wrapper. */
const flat = grouped.length === 0;
---

{
  /* data-motivations / data-unfilterable drive the optional client-side
     filter island (ShelfFilter.svelte). Never present in markup means
     never filtered: with JS disabled every <li> below simply renders,
     which is the correct default. Safety-adjacent cards (tone: risk,
     or carrying a safetyRoute) are marked unfilterable so a motivation
     filter can never hide them. */
}
{
  flat ? (
    <ul class="shelf">
      {untimed.map((card) => (
        <li
          data-motivations={card.data.motivations.join(",")}
          data-unfilterable={card.data.tone === "risk" || Boolean(card.data.safetyRoute)}
        >
          <a href={`/card/${card.id}`} class="card">
            <h2>{card.data.title}</h2>
            {card.data.summary && <p>{card.data.summary}</p>}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="groups">
      {grouped.map((group) => (
        <section class="group" aria-labelledby={`h-${group.horizon}`}>
          <h2 class="group-h" id={`h-${group.horizon}`}>
            {group.label}
          </h2>
          <ul class="shelf">
            {group.cards.map((card) => (
              <li
                data-motivations={card.data.motivations.join(",")}
                data-unfilterable={card.data.tone === "risk" || Boolean(card.data.safetyRoute)}
              >
                <a href={`/card/${card.id}`} class="card">
                  <h3>{card.data.title}</h3>
                  {card.data.summary && <p>{card.data.summary}</p>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      {untimed.length > 0 && (
        <section class="group" aria-label="Not tied to a particular time">
          <ul class="shelf">
            {untimed.map((card) => (
              <li
                data-motivations={card.data.motivations.join(",")}
                data-unfilterable={card.data.tone === "risk" || Boolean(card.data.safetyRoute)}
              >
                <a href={`/card/${card.id}`} class="card">
                  <h3>{card.data.title}</h3>
                  {card.data.summary && <p>{card.data.summary}</p>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}

{
  cards.length === 0 && shelf === "between" ? (
    /* `between` stays at zero cards by design (PRODUCT_BOUNDARY.md):
       writing guidance for someone reading mid-experience is a
       different, higher-risk kind of content this product does not
       yet have a basis for authoring safely. The generic "nothing
       here yet, look elsewhere" copy below would misread this as a
       content gap rather than a deliberate boundary. */
    <div class="empty">
      <p>
        This shelf stays empty on purpose. Guidance written for someone
        reading while something is actively underway is different,
        higher-risk content, and there is no safe basis for it here yet. The
        safety routes above are not affected by that.
      </p>
    </div>
  ) : (
    cards.length === 0 && (
      <div class="empty">
        <img src="/img/constellation-empty.png" alt="" class="empty-glyph" aria-hidden="true" />
        <p>
          Nothing on this shelf yet. Look at{" "}
          <a href="/before">Before</a>, <a href="/integration">Integration</a>, or{" "}
          <a href="/learn">Learn</a> instead.
        </p>
      </div>
    )
  )
}

<style>
  .groups {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-5);
  }
  /* Section headings sit quietly. No group is emphasised over another. */
  .group-h {
    font-family: var(--font-meta);
    font-size: var(--size-meta);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 400;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-3);
  }
  .empty {
    color: var(--dim);
    margin-bottom: var(--space-5);
    text-align: center;
  }
  .empty-glyph {
    width: min(60vw, 300px);
    height: auto;
    opacity: 0.08;
    margin-bottom: var(--space-4);
  }
</style>
